# ==========================================
# VIAJE Car Rental - Production Environment Template
# ==========================================

APP_NAME="VIAJE Car Rental"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://viajecarrental.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Logging: Use daily rotating logs or stderr for Docker/Serverless
LOG_CHANNEL=daily
LOG_LEVEL=error

# ==========================================
# Database Configuration (PostgreSQL or MySQL Recommended)
# Do NOT use SQLite in high-concurrency production.
# ==========================================
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=viajecarrental
DB_USERNAME=viaje_user
DB_PASSWORD=your_strong_database_password

# ==========================================
# High-Throughput Memory Stores (Redis)
# Offloads session data, throttles, and queues from SQLite/MySQL
# ==========================================
CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true

QUEUE_CONNECTION=redis
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ==========================================
# Transactional Email (Resend or Mailgun Custom Domain)
# Do NOT use Mailgun Sandbox in production.
# ==========================================
MAIL_MAILER=mailgun
MAIL_FROM_ADDRESS="bookings@viajecarrental.com"
MAIL_FROM_NAME="VIAJE Car Rental"

MAILGUN_DOMAIN=mg.viajecarrental.com
MAILGUN_SECRET=your_production_mailgun_api_key
MAILGUN_ENDPOINT=api.mailgun.net

# ==========================================
# Stripe Payments (Laravel Cashier)
# Use pk_live_... / sk_live_... for real payments
# Use pk_test_... / sk_test_... for portfolio demos
# ==========================================
STRIPE_KEY=pk_live_your_live_publishable_key
STRIPE_SECRET=sk_live_your_live_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# ==========================================
# Security & Initial Admin Provisioning
# Run: php artisan make:admin
# ==========================================
ADMIN_DEFAULT_PASSWORD=
BCRYPT_ROUNDS=12
